# Tembo Agent Studio — v0.1 skeleton env reference.
# Copy to `.env` and fill in. Do not commit `.env`.

# ── Postgres ──────────────────────────────────────────────────────────────
# Used by both the Rust API (DATABASE_URL) and better-auth (via the web app).
POSTGRES_USER=tas
POSTGRES_PASSWORD=tas
POSTGRES_DB=tas
POSTGRES_PORT=5432

# ── Branding ──────────────────────────────────────────────────────────────
# Shown on the login screen and the signed-in header.
# Example: "ABC Company Agent Portal". Defaults to "Tembo Agent Studio".
TAS_INSTANCE_NAME=

# ── better-auth ───────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin where the web app is reachable. Used for cookie/session URLs.
BETTER_AUTH_URL=http://localhost:3000

# ── Workspace secret encryption ───────────────────────────────────────────
# Required. AES-256-GCM master key, 32 bytes base64. Shared between the
# web container (encrypts on save) and the api container (decrypts to
# invoke provider APIs during a run).
# Generate with: openssl rand -base64 32
# Rotating this orphans all existing workspace secrets (they become
# undecryptable). Treat it like a Postgres master credential.
TAS_ENCRYPTION_KEY=

# ── web ↔ api internal auth ───────────────────────────────────────────────
# Required. Shared bearer token gating /internal/* on the api service.
# The web container sends `Authorization: Bearer ${INTERNAL_API_TOKEN}`.
# Generate with: openssl rand -base64 32
INTERNAL_API_TOKEN=

# ── Agent run concurrency ────────────────────────────────────────────────
# Hard cap on simultaneously executing agent runs in one api process. Extra
# accepted runs remain queued until a slot is available. Each Pydantic run owns
# a Python process, so set this conservatively for the api container's memory.
API_MAX_CONCURRENT_RUNS=4
# Root runs can use max-minus-reserved slots; child runs launched by another
# agent can also use the reserved slots. This prevents the common orchestrator
# pattern from occupying every slot while waiting for a child. Must be less
# than API_MAX_CONCURRENT_RUNS; set 0 when child-run reservation is unnecessary.
API_RESERVED_CHILD_RUNS=1

# ── Sign-in ───────────────────────────────────────────────────────────────
# Quickstart: leave ALL the OAuth providers below blank and the login screen
# offers email + password sign-in (no OAuth app to set up). Sign-up is still
# gated to INSTANCE_ADMIN_EMAILS / invited emails. Configure any OAuth provider
# below and email/password turns off (OAuth becomes the path) — recommended for
# production / multi-user.

# ── Google OAuth (sign-in) ────────────────────────────────────────────────
# Create OAuth 2.0 client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft (Entra ID) sign-in (optional) ───────────────────────────────
# Register an app in Entra ID. Authorized redirect URI:
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/microsoft
# Tenant: a tenant ID, or "common" / "organizations" (default: common).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ── Generic OIDC sign-in (optional: Okta, Auth0, Keycloak, …) ──────────────
# Any OpenID Connect IdP. Authorized redirect URI:
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/oidc
# OIDC_DISCOVERY_URL is the IdP's .well-known/openid-configuration URL.
# OIDC_PROVIDER_NAME is the sign-in button label (default "SSO");
# OIDC_SCOPES defaults to "openid profile email".
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=
OIDC_SCOPES=

# ── Instance admins ───────────────────────────────────────────────────────
# Comma-separated emails granted the instance-admin role. Instance admins
# see the root /settings page (deployment-wide name/branding, and future
# instance config). A user is an instance admin iff their sign-in email is
# listed here. Leave blank for none.
INSTANCE_ADMIN_EMAILS=

# ── Dev: local sample agents (optional) ───────────────────────────────────
# When a workspace has NO connected GitHub repo and this is set, agents load
# (read-only) from this directory instead of GitHub. It must be repo-shaped —
# i.e. contain agents/<framework>/… . docker-compose.yml mounts the repo's
# ./agents at /samples/agents and defaults this to /samples, so the bundled
# sample agents appear with no repo/PAT. Unset (or connect a repo) for GitHub.
# TAS_LOCAL_AGENTS_DIR=/samples

# ── Composio (basic-mode connections) ─────────────────────────────────────
# The Composio API key is workspace-scoped — set it in Settings →
# Composio API key for each workspace (alongside Tembo/Anthropic/OpenAI
# keys). No instance-level env var.
# Get a key at https://app.composio.dev/developers.

# ── Slack connection OAuth (advanced mode, optional) ──────────────────────
# Reserved for the upcoming TAS-owned advanced connections mode (Phase A
# substrate). Leave blank in v0.3 — basic mode uses Composio (above).
# Create a Slack app at https://api.slack.com/apps and add bot scopes
# `chat:write`, `chat:write.public`, `team:read`. OAuth redirect URL:
# ${BETTER_AUTH_URL}/api/connections/slack/callback. Separate from
# sign-in. Until both vars are set, Settings → Connections shows a
# "configuration needed" hint for Slack.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Google connection OAuth (advanced mode, optional) ────────────────────
# Reserved for the TAS-owned advanced connections mode. Leave blank
# in v0.3 — basic mode uses Composio.
# A SECOND OAuth 2.0 client distinct from the sign-in one (different
# scopes / consent screen). Create at
# https://console.cloud.google.com/apis/credentials.
# Scopes used: `https://www.googleapis.com/auth/spreadsheets`,
# `https://www.googleapis.com/auth/userinfo.email`.
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/connections/google/callback
GOOGLE_CONNECTIONS_CLIENT_ID=
GOOGLE_CONNECTIONS_CLIENT_SECRET=

# ── Tembo Coding Agent Platform ───────────────────────────────────────────
# Base URL of the Tembo API used by the "Improve me" form on run detail
# pages (POST /session/create). Override only if you're targeting a
# staging environment. Per-workspace auth uses the workspace's Tembo
# API key (Settings → Tembo API key).
TEMBO_API_URL=https://api.tembo.io

# ── Published images (compose.release.yaml only) ──────────────────────────
# Which GHCR image tag to run when deploying from prebuilt images instead
# of building from source. Pin to a released CalVer version for
# reproducible deploys; bump + `pull && up -d` to upgrade. Ignored by the
# default docker-compose.yml (which builds from source).
TAS_VERSION=2026.5.29
# Override only if pulling from a non-default GHCR namespace (e.g. a fork).
# TAS_IMAGE_OWNER=tembo

# ── Ports (host-side) ─────────────────────────────────────────────────────
API_PORT=8080
WEB_PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────
# Standard `env_logger` / `tracing-subscriber` filter syntax.
RUST_LOG=info,tas_api=debug
